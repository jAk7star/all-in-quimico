      "compound": "#/$defs/OtherRecord",
      "concept": "#/$defs/Concept",
      "constant": "#/$defs/OtherRecord",
      "element": "#/$defs/Element",
      "formula": "#/$defs/Formula",
      "quantity": "#/$defs/OtherRecord",
      "skill": "#/$defs/OtherRecord",
      "unit": "#/$defs/OtherRecord"
